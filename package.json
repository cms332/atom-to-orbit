{
	"name": "a2o",
	"version": "0.1.9",
	"private": true,
	"type": "module",
	"scripts": {
		"deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
		"deploy:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Action status",
		"deploy:rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Action rollback",
		"deploy:tls": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Action tls",
		"deploy:verify": "node scripts/check-deployment.mjs",
		"dev": "vite --host 127.0.0.1",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint . && prettier --check src tests scripts docs static deploy .github \"*.{md,ts,js,json}\" .prettierrc --ignore-unknown",
		"format": "prettier --write src tests scripts docs static deploy .github \"*.{md,ts,js,json}\" .prettierrc --ignore-unknown",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.0",
		"@eslint/js": "^9.0.0",
		"@playwright/test": "^1.50.0",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/canvas-confetti": "^1.9.0",
		"@types/three": "^0.186.0",
		"eslint": "^9.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"lighthouse": "^13.5.0",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^3.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^7.0.0",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"canvas-confetti": "1.9.4",
		"three": "^0.186.1"
	}
}
